{
  "name": "heat-treatment-digital-twin-desktop",
  "version": "2.3.0",
  "description": "热处理数字孪生大屏 Windows 桌面部署版",
  "main": "main.cjs",
  "author": "Digital Twin Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.cjs",
    "prepare:resources": "node scripts/prepare-resources.cjs && npm run prepare:ffmpeg && node scripts/generate-third-party-notices.cjs",
    "build:frontend": "npm --prefix ../frontend run build",
    "build:unity": "node scripts/build-unity-client.cjs",
    "build:unity:force": "node scripts/build-unity-client.cjs --force",
    "build:admin-host": "node scripts/build-native-admin-host.cjs",
    "test:logs": "node scripts/log-manager-test.cjs",
    "test:processes": "node --test scripts/process-lifecycle-test.cjs scripts/desktop-supervisor-unit-test.cjs",
    "test:resources": "node --test scripts/resource-preparation-test.cjs",
    "test:supervisor": "node scripts/backend-supervisor-test.cjs",
    "test:admin-host-parent": "node scripts/admin-host-parent-test.cjs",
    "dist": "npm run build:frontend && npm run build:unity && npm run build:admin-host && npm run prepare:resources && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.digitaltwin.heattreatment",
    "productName": "热处理数字孪生大屏",
    "asar": true,
    "directories": {
      "output": "../安装包"
    },
    "files": [
      "main.cjs",
      "logManager.cjs",
      "processLifecycle.cjs",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../shared",
        "to": "shared",
        "filter": ["*.cjs", "*.mjs"]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**/*",
          "!uploads/**/*",
          "!node_modules/**/*",
          "!scripts/**/*",
          "!assets/models/*.blend",
          "!assets/models/*.blend1",
          "!*.log"
        ]
      },
      {
        "from": "resources/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/backend-dependencies.tar",
        "to": "backend-dependencies.tar"
      },
      {
        "from": "resources/native-client",
        "to": "native-client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "README-交付说明.md",
        "to": "README-交付说明.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "热处理数字孪生大屏-安装包-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "热处理数字孪生大屏",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
