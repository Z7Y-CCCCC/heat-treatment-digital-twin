{
  "name": "heat-treatment-digital-twin-desktop",
  "version": "2.3.2",
  "description": "热处理数字孪生大屏 Windows 桌面部署版",
  "main": "main.cjs",
  "author": "Digital Twin Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.cjs",
    "prepare:mysql": "node scripts/prepare-mysql-runtime.cjs",
    "prepare:resources": "node scripts/prepare-resources.cjs && npm run prepare:ffmpeg && node scripts/generate-third-party-notices.cjs && npm run prepare:prerequisites",
    "build:frontend": "node scripts/build-frontend.cjs",
    "build:unity": "node scripts/build-unity-client.cjs",
    "build:unity:force": "node scripts/build-unity-client.cjs --force",
    "build:admin-host": "node scripts/build-native-admin-host.cjs",
    "build:collector-service": "node scripts/build-collector-service.cjs",
    "test:logs": "node scripts/log-manager-test.cjs",
    "test:processes": "node --test scripts/process-lifecycle-test.cjs scripts/desktop-supervisor-unit-test.cjs scripts/activation-client-test.cjs",
    "test:resources": "node --test --test-concurrency=1 scripts/resource-preparation-test.cjs scripts/runtime-cache-test.cjs scripts/release-frontend-cache-test.cjs scripts/dependency-cache-test.cjs scripts/directory-publish-test.cjs scripts/native-client-path-test.cjs scripts/optional-collector-test.cjs scripts/prerequisites-test.cjs scripts/installer-ui-test.cjs scripts/workspace-frontend-test.cjs",
    "preview:installer": "node scripts/installer-preview.cjs",
    "test:deployment": "node --test scripts/deployment-test.cjs scripts/desktop-supervisor-unit-test.cjs",
    "build:collector-center": "node scripts/build-collector-center.cjs",
    "test:collector-center": "node scripts/native-collector-center-test.cjs && node scripts/native-point-client-test.cjs && node --test scripts/service-installer-test.cjs",
    "collector-center": "node scripts/build-collector-center.cjs && start \"\" .cache\\collector-center\\HeatTreatmentCollectorCenter.exe",
    "test:supervisor": "node scripts/backend-supervisor-test.cjs",
    "test:admin-host-parent": "node scripts/admin-host-parent-test.cjs",
    "test:admin-host-retry": "node scripts/admin-host-retry-test.cjs",
    "dist": "node scripts/build-release.cjs",
    "prepare:prerequisites": "node scripts/prepare-prerequisites.cjs"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.digitaltwin.heattreatment",
    "productName": "热处理数字孪生大屏",
    "asar": true,
    "directories": {
      "output": "../安装包"
    },
    "files": [
      "prerequisites.cjs",
      "main.cjs",
      "logManager.cjs",
      "processLifecycle.cjs",
      "mysqlRuntime.cjs",
      "directoryPublish.cjs",
      "templateData.cjs",
      "deployment.cjs",
      "deployment-preload.cjs",
      "activation.cjs",
      "nativeClientPath.cjs",
      "startup-preload.cjs",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/licensing",
        "to": "licensing",
        "filter": [
          "license-public-key.pem"
        ]
      },
      {
        "from": "resources/mysql",
        "to": "mysql",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "*.cjs",
          "*.mjs",
          "motionPackages.json"
        ]
      },
      {
        "from": ".cache/frontend-dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**/*",
          "!uploads/**/*",
          "!node_modules/**/*",
          "!scripts/**/*",
          "!assets/models/**/*",
          "!assets/motions/**/*",
          "!*.log",
          "!services/collectorProcess.js",
          "!services/collectorWorker.cjs",
          "!services/plcReader.js",
          "!services/plcProtocolDrivers.js",
          "!services/s7ReadSafety.js"
        ]
      },
      {
        "from": "resources/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/backend-dependencies.tar",
        "to": "backend-dependencies.tar"
      },
      {
        "from": "resources/native-client",
        "to": "native-client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "README-交付说明.md",
        "to": "README-交付说明.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "assets/display-distribution.json",
        "to": "backend/distribution.json"
      },
      {
        "from": "resources/prerequisites",
        "to": "prerequisites",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "部署与连接.cmd",
        "to": "部署与连接.cmd"
      },
      {
        "from": "现场部署选项.ps1",
        "to": "现场部署选项.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "热处理数字孪生大屏-安装包-${version}-${arch}.${ext}"
    },
    "nsis": {
      "perMachine": true,
      "include": "display-installer.nsh",
      "oneClick": false,
      "differentialPackage": false,
      "useZip": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "热处理数字孪生大屏",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "uninstallerSidebar": "assets/installer-sidebar.bmp"
    }
  }
}
